# Copy this file to .env (git-ignored) and adjust. Every setting is optional for
# local development: without a .env file the project runs with DEBUG on and a
# built-in placeholder key.

# Secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required when DJANGO_DEBUG is off.
DJANGO_SECRET_KEY="CHANGE ME"

# True (default) for local development, False for anything else.
DJANGO_DEBUG=True

# Comma-separated host names the site may be served from. Leave empty for local
# development (localhost and 127.0.0.1 are always accepted while DEBUG is on).
DJANGO_ALLOWED_HOSTS=

# Optional: passwords for the demo users created by `manage.py seed_users`.
# SEED_SUPERUSER_PASSWORD=
# SEED_ADMINISTRATOR_PASSWORD=
# SEED_READONLY_PASSWORD=
